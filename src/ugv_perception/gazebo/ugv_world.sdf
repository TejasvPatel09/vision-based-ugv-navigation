<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ugv_world">

    <gravity>0 0 -9.81</gravity>

    <!-- Physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <!-- Required for camera / lidar / sensors -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>


    <!-- ==================== GROUND ==================== -->

    <model name="ground">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ==================== UGV ==================== -->

    <include>
      <uri>file:///home/tejasvpatel/ugv_ws/src/ugv_perception/gazebo/gz_waffle_camera.sdf</uri>
      <name>ugv</name>
      <pose>0 0 0.1 0 0 0</pose>
    </include>


    <!-- ==================== OBSTACLE 1 ==================== -->

    <model name="obstacle_1">
      <static>true</static>

      <pose>2.0 0.0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ==================== OBSTACLE 2 ==================== -->

    <model name="obstacle_2">
      <static>true</static>

      <pose>4.0 1.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>


        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ==================== OBSTACLE 3 ==================== -->

    <model name="obstacle_3">
      <static>true</static>

      <pose>6.0 -1.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

  </world>
</sdf>
